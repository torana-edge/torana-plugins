{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {"required": ["mode", "ladders"], "properties": {"mode": {"enum": ["shadow", "advise", "confirm", "auto"]}}},
    {"required": ["mode"], "properties": {"mode": {"const": "off"}}, "maxProperties": 1}
  ],
  "properties": {
    "mode": {"type": "string", "enum": ["shadow", "advise", "confirm", "auto", "off"], "title": "Mode", "description": "Measure, advise, switch after consent, or explicitly opt into guarded upward routing."},
    "ladders": {
      "type": "object", "minProperties": 1, "maxProperties": 32,
      "title": "Provider ladders", "description": "Ordered model steps for each Torana provider.",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["start", "steps"],
        "properties": {
          "start": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "steps": {"type": "array", "minItems": 2, "maxItems": 32, "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "description", "model"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
              "model": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
              "effort": {"type": "string", "enum": ["minimal", "low", "medium", "high", "xhigh", "max"]},
              "aliases": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"}},
              "pricing": {"type": "object", "additionalProperties": false, "properties": {
                "input": {"type": "number", "minimum": 0},
                "output": {"type": "number", "minimum": 0},
                "cache_read": {"type": "number", "minimum": 0},
                "cache_write": {"type": "number", "minimum": 0}
              }}
            }
          }}
        }
      }
    },
    "classifier": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "decision_model": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$"},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "inputs": {"type": "string", "enum": ["user_turn+signals", "signals"], "default": "user_turn+signals", "description": "Send only the latest user turn and bounded signals, or signals alone, to the classifier."},
        "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "max_state_bytes": {"type": "integer", "minimum": 256, "maximum": 65536},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 1500},
        "authentication": {"type": "string", "enum": ["none", "bearer"]}
      }
    },
    "manage_effort": {"type": "boolean", "default": false, "description": "Explicitly let Torana manage effort; otherwise the harness remains authoritative."},
    "escalation": {"type": "object", "additionalProperties": false, "properties": {
      "max_model_switches": {"type": "integer", "minimum": 1, "maximum": 20, "default": 1},
      "max_switch_cost_usd": {"type": "number", "minimum": 0, "maximum": 100, "default": 0.5},
      "suggest_deescalation": {"type": "boolean", "default": false},
      "min_user_turns_before_deescalation": {"type": "integer", "minimum": 1, "maximum": 100, "default": 3}
    }},
    "triggers": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tool_error_window": {"type": "integer", "minimum": 1, "maximum": 64},
        "tool_error_threshold": {"type": "integer", "minimum": 1, "maximum": 64},
        "retry_streak": {"type": "integer", "minimum": 1, "maximum": 100},
        "requests_per_user_turn": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_tokens_finishes": {"type": "integer", "minimum": 1, "maximum": 100},
        "reevaluate_every_user_turns": {"type": "integer", "minimum": 1, "maximum": 100},
        "suggestion_cooldown_user_turns": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
