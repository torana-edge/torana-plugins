{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {"required": ["mode", "ladders"], "properties": {"mode": {"const": "shadow"}}},
    {"required": ["mode"], "properties": {"mode": {"const": "off"}}, "maxProperties": 1}
  ],
  "properties": {
    "mode": {"type": "string", "enum": ["shadow", "off"], "title": "Mode", "description": "Measure possible route suggestions without changing requests, or turn the plugin off."},
    "ladders": {
      "type": "object", "minProperties": 1, "maxProperties": 32,
      "title": "Provider ladders", "description": "Ordered model steps for each Torana provider.",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["start", "steps"],
        "properties": {
          "start": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "steps": {"type": "array", "minItems": 2, "maxItems": 32, "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "description", "model"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
              "model": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"}
            }
          }}
        }
      }
    },
    "classifier": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "decision_model": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$"},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "max_state_bytes": {"type": "integer", "minimum": 256, "maximum": 65536},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 1500},
        "authentication": {"type": "string", "enum": ["none", "bearer"]}
      }
    },
    "triggers": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tool_error_window": {"type": "integer", "minimum": 1, "maximum": 64},
        "tool_error_threshold": {"type": "integer", "minimum": 1, "maximum": 64},
        "reevaluate_every_user_turns": {"type": "integer", "minimum": 1, "maximum": 100},
        "suggestion_cooldown_user_turns": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
