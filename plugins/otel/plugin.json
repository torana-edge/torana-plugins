{
  "schema_version": 1,
  "id": "torana/otel",
  "name": "otel",
  "version": "0.5.0",
  "abi_version": "v2",
  "minimum_torana_version": "0.1.0",
  "failure_mode": "pass",
  "repository": "https://github.com/torana-edge/torana-plugins",
  "description": "OpenTelemetry per-request metrics: request shape on the way in; latency, status class, and token usage on the way out",
  "hooks": [
    {
      "name": "run_before_request"
    },
    {
      "name": "run_after_response"
    },
    {
      "name": "run_on_http_request"
    }
  ],
  "permissions": [
    {
      "name": "env.emit_metric",
      "description": "Emit OTel-compatible metrics"
    },
    {
      "name": "env.serve_http",
      "description": "Serve a status/info page under /_torana/plugin/otel/"
    }
  ]
}
