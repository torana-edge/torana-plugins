{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allow": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "When present, only these tool names may reach the model. An empty array removes every tool."
    },
    "deny": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Tool names removed from the model-visible definition list. Must not overlap allow."
    },
    "replace": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/replacement"
      },
      "default": {},
      "description": "Definition fields to replace when the named tool is present and retained."
    }
  },
  "$defs": {
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "strict": {
          "type": "boolean"
        }
      }
    }
  }
}
